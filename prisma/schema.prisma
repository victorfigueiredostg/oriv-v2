// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Empreendimento {
  id          Int       @id @default(autoincrement())
  nome        String
  logoUrl     String?   // URL Cloudinary — logo horizontal (topo do formulário)
  iconeUrl    String?   // URL Cloudinary — ícone quadrado (card da landing)
  slug        String    @unique
  ativo       Boolean   @default(true)
  criadoEm    DateTime  @default(now())
  usuarios    Usuario[]
  visitas     Visita[]
}

model Usuario {
  id               Int             @id @default(autoincrement())
  usuario          String          @unique
  senhaHash        String
  role             Role            @default(STAND)
  empreendimentoId Int?
  empreendimento   Empreendimento? @relation(fields: [empreendimentoId], references: [id])
  criadoEm         DateTime        @default(now())
  visitas          Visita[]
}

model Visita {
  id               Int            @id @default(autoincrement())
  empreendimentoId Int
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id])
  usuarioId        Int
  usuario          Usuario        @relation(fields: [usuarioId], references: [id])
  nomeCliente      String
  idadeCliente     Int?           // idade numérica (legado); mantido p/ registros antigos
  faixaEtaria      String?        // faixa etária do lead (novo formato do cadastro)
  telefone         String?        // telefone do lead; opcional (usado tb na verificação no CVCRM)
  comoChegou       ComoChegou
  corretor         String
  imobiliaria      String
  comoSoube        ComoSoube
  ondeMaisViu      String?        // "Onde mais viu/ouviu" — múltiplas origens (CSV de ComoSoube)
  cvStatus         String?        // CADASTRADO | NAO_CADASTRADO | NAO_PREENCHEU (verificado no CVCRM ao salvar)
  cvConfirmadoEm   DateTime?      // data em que o cadastro foi validado no CV (re-check diário ou confirmação manual)
  cvVerificadoEm   DateTime?      // último re-check automático do CV (controle do job diário)
  motivoLost       String?        // motivo de "lost" (texto; opções gerenciadas em MotivoLost)
  salvoEm          DateTime       @default(now())

  @@index([empreendimentoId])
  @@index([salvoEm])
  @@index([corretor])
  @@index([comoSoube])
  @@index([imobiliaria])
  @@index([cvVerificadoEm])
  @@index([motivoLost])
}

model Imobiliaria {
  id       Int      @id @default(autoincrement())
  nome     String   @unique
  criadoEm DateTime @default(now())
}

// Configurações chave-valor (ex.: credenciais de integração de API)
model Configuracao {
  chave String @id
  valor String
}

// Opções do dropdown "Motivo de lost" (gerenciadas em Configurações).
// Inativar remove do dropdown mas preserva o histórico das visitas.
model MotivoLost {
  id       Int      @id @default(autoincrement())
  nome     String   @unique
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())
}

enum Role {
  ADMIN
  STAND
  GESTOR
}

enum ComoChegou {
  AGENDADO_CORRETOR
  CLIENTE_PASSANTE
  AGENDAMENTO_SELENA
}

enum ComoSoube {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  CORRETOR
  PANFLETO
  TV
  RADIO
  STAND_CENTRAL_VENDAS
  INDICACAO
  OUTDOOR
  OBRA
  FAIXA_PASSARELA_SAO_CRISTOVAO
  GOOGLE
  SITE
  TV_HOSPITAL_SAO_RAFAEL
}
